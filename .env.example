# Host port exposed by Docker Compose.
SCRAPS_CACHE_PORT=3000

# Published image used by docker/compose.production.yaml. Always pin a release or digest.
SCRAPS_CACHE_IMAGE=ghcr.io/volturine/scraps-cache:0.0.1

# Exact public URL. Use https://scrapscache.com behind a reverse proxy,
# or https://scraps-cache.<tailnet>.ts.net with docker/compose.tailscale.yaml.
SCRAPS_CACHE_ORIGIN=http://localhost:3000

# Adapter-level request limit. Keep above the application's 101 MB sync request cap.
SCRAPS_CACHE_BODY_SIZE_LIMIT=110M

# Leave blank when Node receives traffic directly. Behind one trusted reverse
# proxy, set these exactly as shown and have that proxy replace X-Forwarded-For.
SCRAPS_CACHE_ADDRESS_HEADER=
SCRAPS_CACHE_XFF_DEPTH=1

# Per-account server-side encrypted storage limits.
SCRAPS_CACHE_SYNC_MAX_ACCOUNT_BYTES=1000000000
SCRAPS_CACHE_SYNC_MAX_ACCOUNT_ENVELOPES=50000

# Maximum simultaneous sync requests handled by the single Node process.
SCRAPS_CACHE_SYNC_MAX_CONCURRENT_REQUESTS=8

# Consistent online SQLite snapshots. The production Compose file mounts this path.
SCRAPS_CACHE_BACKUP_DIR=/backups
SCRAPS_CACHE_BACKUP_INTERVAL_HOURS=24
SCRAPS_CACHE_BACKUP_RETAIN=2

# Required to read /metrics or trigger POST /api/admin/backup.
SCRAPS_CACHE_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional. If unset, VAPID keys are generated once and stored in SQLite.
# Pin them here if you rebuild the data directory and want existing push
# subscriptions to keep working.
SCRAPS_CACHE_VAPID_PUBLIC_KEY=
SCRAPS_CACHE_VAPID_PRIVATE_KEY=
SCRAPS_CACHE_VAPID_SUBJECT=

# Optional Tailscale Serve overlay (docker/compose.tailscale.yaml).
# Machine name becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=scraps-cache
# Auth key or OAuth client secret. Required when the overlay is enabled.
# TS_AUTHKEY=
# OAuth clients must advertise a tag defined in your tailnet ACLs:
# TS_EXTRA_ARGS=--advertise-tags=tag:container
