# Host port exposed by Docker Compose.
SHARD_PORT=3000

# Published image used by docker/compose.production.yaml. Always pin a release or digest.
SHARD_IMAGE=ghcr.io/volturine/shard-notes:0.0.1

# Exact public URL. Use https://notes.example.com behind a reverse proxy,
# or https://shard.<tailnet>.ts.net with docker/compose.tailscale.yaml.
SHARD_ORIGIN=http://localhost:3000

# Adapter-level request limit. Keep above the application's 101 MB sync request cap.
SHARD_BODY_SIZE_LIMIT=110M

# Leave blank when Node receives traffic directly. Behind one trusted reverse
# proxy, set these exactly as shown and have that proxy replace X-Forwarded-For.
SHARD_ADDRESS_HEADER=
SHARD_XFF_DEPTH=1

# Per-account server-side encrypted storage limits.
SHARD_SYNC_MAX_ACCOUNT_BYTES=1000000000
SHARD_SYNC_MAX_ACCOUNT_ENVELOPES=50000

# Maximum simultaneous sync requests handled by the single Node process.
SHARD_SYNC_MAX_CONCURRENT_REQUESTS=8

# Consistent online SQLite snapshots. The production Compose file mounts this path.
SHARD_BACKUP_DIR=/backups
SHARD_BACKUP_INTERVAL_HOURS=24
SHARD_BACKUP_RETAIN=2

# Required to read /metrics or trigger POST /api/admin/backup.
SHARD_ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional Tailscale Serve overlay (docker/compose.tailscale.yaml).
# Machine name becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=shard
# Auth key or OAuth client secret. Required when the overlay is enabled.
# TS_AUTHKEY=
# OAuth clients must advertise a tag defined in your tailnet ACLs:
# TS_EXTRA_ARGS=--advertise-tags=tag:container
