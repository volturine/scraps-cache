# Host interface and port the Compose service publishes to. Loopback by
# default: expose the app through a reverse proxy or Cloudflare Tunnel instead
# of opening the port. Set SCRAPSCACHE_BIND=0.0.0.0 only for direct exposure.
SCRAPSCACHE_BIND=127.0.0.1
SCRAPSCACHE_PORT=3000

# Published image used by compose.yaml. Always pin a release or digest.
SCRAPSCACHE_IMAGE=ghcr.io/volturine/scrapscache:0.0.1

# Exact public URL, e.g. https://scrapscache.com behind a reverse proxy or
# Cloudflare Tunnel, or https://scrapscache.<tailnet>.ts.net with the Tailscale
# overlay.
SCRAPSCACHE_ORIGIN=http://localhost:3000

# Adapter-level request limit. Keep above the application's 101 MB sync request cap.
SCRAPSCACHE_BODY_SIZE_LIMIT=110M

# Leave blank when Node receives traffic directly. Behind one trusted reverse
# proxy, set these exactly as shown and have that proxy replace X-Forwarded-For.
SCRAPSCACHE_ADDRESS_HEADER=
SCRAPSCACHE_XFF_DEPTH=1

# Per-account server-side encrypted storage limits.
SCRAPSCACHE_SYNC_MAX_ACCOUNT_BYTES=1000000000

# Maximum simultaneous sync requests handled by the single Node process.
SCRAPSCACHE_SYNC_MAX_CONCURRENT_REQUESTS=8

# Optional. Unset (empty) disables /metrics and the admin API entirely.
# To enable them, set a long random secret, e.g. openssl rand -hex 32
# SCRAPSCACHE_ADMIN_TOKEN=

# Delete accounts with no authenticated activity for this many days.
# 0 disables the daily sweeper. Enable only after last-seen tracking has been live.
SCRAPSCACHE_RETENTION_INACTIVE_DAYS=0

# Optional. If unset, VAPID keys are generated once and stored in SQLite.
# Pin them here if you rebuild the data directory and want existing push
# subscriptions to keep working.
SCRAPSCACHE_VAPID_PUBLIC_KEY=
SCRAPSCACHE_VAPID_PRIVATE_KEY=
SCRAPSCACHE_VAPID_SUBJECT=

# Optional Tailscale Serve overlay (compose.tailscale.yaml).
# Machine name becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=scrapscache
# Auth key or OAuth client secret. Required when the overlay is enabled.
# TS_AUTHKEY=
# OAuth clients must advertise a tag defined in your tailnet ACLs:
# TS_EXTRA_ARGS=--advertise-tags=tag:container
