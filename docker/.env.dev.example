# Host port for the PR preview stack. Loopback like production; set
# SCRAPSCACHE_BIND=0.0.0.0 in docker/.env.dev to reach it from other devices.
# Master/production uses 5173 here.
SCRAPSCACHE_PORT=3000
# With the Tailscale overlay: https://dev-scrapscache.<tailnet>.ts.net
SCRAPSCACHE_ORIGIN=http://localhost:3000

# Published PR image. CI tags: dev-<pr> and dev-sha-<commit>.
# Example: ghcr.io/volturine/scrapscache:dev-23
SCRAPSCACHE_IMAGE=ghcr.io/volturine/scrapscache:dev-23

# Optional. Unset disables /metrics and admin endpoints in the preview stack.
# To enable them, generate a fresh random value, e.g. openssl rand -hex 32
# SCRAPSCACHE_ADMIN_TOKEN=

# Optional Tailscale Serve overlay (compose.tailscale.yaml).
# Preview-only hostname. Production uses TS_HOSTNAME=scrapscache.
TS_HOSTNAME=dev-scrapscache
# TS_AUTHKEY=
# TS_EXTRA_ARGS=--advertise-tags=tag:container
