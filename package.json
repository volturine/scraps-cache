{
	"name": "scraps-cache",
	"private": true,
	"version": "0.0.1",
	"description": "Offline-first notes with optional end-to-end encrypted cloud sync",
	"license": "MIT",
	"author": "Roland Rajcsanyi",
	"homepage": "https://scrapscache.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/volturine/scraps-cache.git"
	},
	"bugs": {
		"url": "https://github.com/volturine/scraps-cache/issues"
	},
	"keywords": [
		"notes",
		"offline-first",
		"end-to-end-encryption",
		"self-hosted",
		"sveltekit",
		"pwa",
		"sync"
	],
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate": "npm run check && npm run format:check && npm test && npm run build",
		"prepare": "svelte-kit sync || echo '' && simple-git-hooks || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.2.0",
		"@types/web-push": "^3.6.4",
		"@typescript/native": "npm:typescript@7.0.2",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.13.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@cipherman/pake-js": "^0.1.1",
		"@lucide/svelte": "^1.33.0",
		"@noble/ciphers": "^2.3.0",
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"better-sqlite3": "^13.0.3",
		"idb": "^8.0.3",
		"web-push": "^3.6.7"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}
