{
	"name": "shard-notes",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:restore": "node scripts/restore-smoke.mjs",
		"test:watch": "vitest",
		"validate": "npm run check && npm test && npm run test:restore && npm run build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.1.2",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"@typescript/native": "npm:typescript@7.0.2"
	},
	"dependencies": {
		"@cipherman/pake-js": "^0.1.1",
		"@noble/ciphers": "^2.2.0",
		"@noble/curves": "^2.2.0",
		"@noble/hashes": "^2.2.0",
		"better-sqlite3": "^13.0.2",
		"idb": "^8.0.3"
	}
}
