{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "scrapscache-cron",
	"main": "cron.ts",
	"compatibility_date": "2026-08-28",
	"workers_dev": false,
	"services": [
		{
			"binding": "APP",
			"service": "scrapscache"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	},
	"env": {
		"dev": {
			"services": [
				{
					"binding": "APP",
					"service": "scrapscache-dev"
				}
			]
		}
	}
}
