# Host port for the PR preview stack. Master/production uses 5173 here.
SHARD_PORT=3000
# With the Tailscale overlay: https://dev-shard.<tailnet>.ts.net
SHARD_ORIGIN=http://localhost:3000

# Published PR image. CI tags: dev-<pr> and dev-sha-<commit>.
# Example: ghcr.io/volturine/shard-notes:dev-23
SHARD_IMAGE=ghcr.io/volturine/shard-notes:dev-23

# Preview-only token. Do not reuse the production SHARD_ADMIN_TOKEN.
SHARD_ADMIN_TOKEN=development-only-admin-token

# Optional Tailscale Serve overlay (docker/compose.tailscale.yaml).
# Preview-only hostname. Production uses TS_HOSTNAME=shard.
TS_HOSTNAME=dev-shard
# TS_AUTHKEY=
# TS_EXTRA_ARGS=--advertise-tags=tag:container
