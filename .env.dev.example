# Host port for the PR preview stack. Master/production uses 5173 here.
SCRAPS_CACHE_PORT=3000
# With the Tailscale overlay: https://dev-scraps-cache.<tailnet>.ts.net
SCRAPS_CACHE_ORIGIN=http://localhost:3000

# Published PR image. CI tags: dev-<pr> and dev-sha-<commit>.
# Example: ghcr.io/volturine/scraps-cache:dev-23
SCRAPS_CACHE_IMAGE=ghcr.io/volturine/scraps-cache:dev-23

# Preview-only token. Do not reuse the production SCRAPS_CACHE_ADMIN_TOKEN.
SCRAPS_CACHE_ADMIN_TOKEN=development-only-admin-token

# Optional Tailscale Serve overlay (docker/compose.tailscale.yaml).
# Preview-only hostname. Production uses TS_HOSTNAME=scraps-cache.
TS_HOSTNAME=dev-scraps-cache
# TS_AUTHKEY=
# TS_EXTRA_ARGS=--advertise-tags=tag:container
